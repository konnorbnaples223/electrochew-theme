/* ══ COMPARISON ══ */
.ec-sci-compare-block{background:#050b1f;padding:96px 0;position:relative;}
.ec-sci-compare-glow-left{position:absolute;top:50%;left:15%;transform:translateY(-50%);width:500px;height:500px;background:radial-gradient(circle,rgba(239,83,80,.08) 0%,transparent 70%);filter:blur(60px);pointer-events:none;}
.ec-sci-compare-glow-right{position:absolute;top:50%;right:10%;transform:translateY(-50%);width:600px;height:600px;background:radial-gradient(circle,rgba(79,195,247,.12) 0%,transparent 70%);filter:blur(60px);pointer-events:none;}
.ec-sci-compare-header{text-align:center;margin-bottom:56px;}
.ec-sci-compare-header .ec-sci-label{justify-content:center;}
.ec-sci-compare-header .ec-sci-label::before{display:none;}
.ec-sci-compare-title{font-family:var(--ec-font-display);font-size:clamp(36px,4vw,58px);line-height:.95;letter-spacing:1px;color:white;text-transform:uppercase;margin:0;}
.ec-sci-compare{display:grid;grid-template-columns:1fr 80px 1fr;gap:0;align-items:stretch;max-width:1000px;margin:0 auto;}
.ec-sci-compare-vs{font-family:var(--ec-font-display);font-size:28px;color:rgba(255,255,255,.15);text-align:center;letter-spacing:3px;display:flex;align-items:center;justify-content:center;}
.ec-sci-compare-col{padding:44px 40px;border-radius:24px;}
.ec-sci-compare-them{background:rgba(239,83,80,.06);border:1px solid rgba(239,83,80,.2);}
.ec-sci-compare-us{background:white;position:relative;box-shadow:0 0 0 1px rgba(79,195,247,.4),0 24px 80px rgba(79,195,247,.18),0 0 60px rgba(79,195,247,.08);}
.ec-sci-compare-badge{display:inline-block;font-family:var(--ec-font-mono);font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--ec-accent);background:rgba(79,195,247,.12);border:1px solid rgba(79,195,247,.3);border-radius:999px;padding:5px 12px;margin-bottom:16px;}
.ec-sci-compare-label{font-family:var(--ec-font-display);font-size:24px;letter-spacing:2px;text-transform:uppercase;color:rgba(239,83,80,.7);margin-bottom:28px;display:flex;align-items:center;gap:10px;}
.ec-sci-compare-label svg{flex-shrink:0;}
.ec-sci-compare-label-us{color:var(--ec-navy);}
.ec-sci-compare-item{display:flex;align-items:flex-start;gap:12px;font-size:14.5px;line-height:1.5;color:rgba(255,255,255,.45);padding:14px 0;border-bottom:1px solid rgba(255,255,255,.06);}
.ec-sci-compare-item:last-child{border-bottom:none;padding-bottom:0;}
.ec-sci-compare-us .ec-sci-compare-item{color:rgba(10,21,64,.7);border-bottom-color:rgba(10,21,64,.07);}
.ec-sci-compare-bad svg{color:#ef5350;flex-shrink:0;margin-top:2px;}
.ec-sci-compare-good{color:rgba(10,21,64,.85) !important;font-weight:600;}
.ec-sci-compare-good svg{color:#1565c0;flex-shrink:0;margin-top:2px;}

/* ══ DISCLAIMER ══ */
.ec-sci-disclaimer-block{background:#050b1f;padding:32px 0 64px;border-top:1px solid rgba(255,255,255,.04);}
.ec-sci-disclaimer{font-size:11px;color:rgba(255,255,255,.25);line-height:1.65;max-width:820px;}

/* ══ RESPONSIVE ══ */
@media(max-width:1024px){
  .ec-sci-delivery{grid-template-columns:1fr;gap:48px;}
  .ec-sci-compare{grid-template-columns:1fr;gap:20px;}
  .ec-sci-compare-vs{display:none;}
  .ec-sci-hero-stats{grid-template-columns:repeat(3,1fr);}
  .ec-sci-compare-glow-left,.ec-sci-compare-glow-right{display:none;}
}
@media(max-width:768px){
  .ec-sci-hero{padding:120px 0 0;}
  .ec-sci-hero-stats{grid-template-columns:1fr;}
  .ec-sci-hero-stat{border-right:none;border-bottom:1px solid rgba(79,195,247,.1);}
  .ec-sci-hero-stat:last-child{border-bottom:none;}
  .ec-sci-cards{grid-template-columns:1fr;}
  .ec-sci-mineral{grid-template-columns:90px 1fr;gap:28px;}
  .ec-sci-tile{width:80px;height:80px;}
  .ec-sci-tile-sym{font-size:34px;}
}
@media(max-width:480px){
  .ec-sci-why,.ec-sci-minerals-block,.ec-sci-delivery-block,.ec-sci-compare-block{padding:64px 0;}
}
</style>

