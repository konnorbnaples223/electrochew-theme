<div class="ec-proof-bar" id="section-{{ section.id }}">
  <div class="ec-proof-bar-inner">
    <div class="ec-container">
      <div class="ec-proof-grid">
        {%- for block in section.blocks -%}
          <div class="ec-proof-item" {{ block.shopify_attributes }}>
            <div class="ec-proof-num" data-counter-num="{{ block.settings.counter_target }}" data-counter-suffix="{{ block.settings.counter_suffix }}">{{ block.settings.number }}</div>
            <div class="ec-proof-label">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<style>
.ec-proof-bar{background:var(--ec-navy);position:relative;overflow:hidden;}
.ec-proof-bar::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(79,195,247,.04) 1px,transparent 1px),linear-gradient(rgba(79,195,247,.04) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;}
.ec-proof-bar-inner{position:relative;z-index:1;padding:52px 0;}
.ec-proof-grid{display:grid;grid-template-columns:repeat(4,1fr);}
.ec-proof-item{text-align:center;padding:0 40px;border-right:1px solid rgba(255,255,255,.07);}
.ec-proof-item:last-child{border-right:none;}
.ec-proof-num{font-family:var(--ec-font-display);font-size:56px;line-height:1;color:white;letter-spacing:1px;transition:color .3s;}
.ec-proof-item:hover .ec-proof-num{color:var(--ec-accent);}
.ec-proof-label{font-family:var(--ec-font-mono);font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:rgba(255,255,255,.38);margin-top:10px;}
@media(max-width:1024px){
  .ec-proof-grid{grid-template-columns:1fr 1fr;}
  .ec-proof-item:nth-child(2){border-right:none;}
  .ec-proof-item:nth-child(3),.ec-proof-item:nth-child(4){border-top:1px solid rgba(255,255,255,.07);padding-top:32px;margin-top:32px;}
}
@media(max-width:640px){
  .ec-proof-grid{grid-template-columns:1fr 1fr;}
  .ec-proof-item{padding:16px 20px;}
  .ec-proof-num{font-size:44px;}
}
</style>

{% schema %}
{
  "name": "Proof bar",
  "tag": "section",
  "blocks":[{
    "type":"stat","name":"Stat",
    "settings":[
      {"type":"text","id":"number","label":"Display value","default":"5-10"},
      {"type":"text","id":"label","label":"Label","default":"Minutes to Full Absorption"},
      {"type":"text","id":"counter_target","label":"Counter end value (number only, optional)","info":"If set, number counts up to this value on scroll. Leave blank to skip animation.","default":"0"},
      {"type":"text","id":"counter_suffix","label":"Counter suffix (e.g. x, %, +)","default":"+"}
    ]
  }],
  "max_blocks":4,
  "presets":[{
    "name":"Proof bar",
    "blocks":[
      {"type":"stat","settings":{"number":"5-10","label":"Minutes to Full Absorption","counter_target":"","counter_suffix":""}},
      {"type":"stat","settings":{"number":"3x","label":"Electrolytes per Piece","counter_target":"3","counter_suffix":"x"}},
      {"type":"stat","settings":{"number":"0g","label":"Sugar Per Serving","counter_target":"0","counter_suffix":"g"}},
      {"type":"stat","settings":{"number":"100%","label":"Clean Formula","counter_target":"100","counter_suffix":"%"}}
    ]
  }]
}
{% endschema %}
