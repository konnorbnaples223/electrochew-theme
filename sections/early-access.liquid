{%- comment -%}
  Early Access — email signup section.
  Drag-and-drop section: appears in the theme editor's "Add section" picker
  for the home page. Posts directly to Shopify's customer endpoint so emails
  land in Customers > tagged "early-access,launch-list,homepage".
{%- endcomment -%}

{%- liquid
  assign sec_id      = section.id
  assign bg_style    = section.settings.bg_style
  assign launch_date = section.settings.launch_date
-%}

<section
  class="ec-early-section ec-early-bg-{{ bg_style }}"
  id="ec-early-{{ sec_id }}"
  data-launch-date="{{ launch_date }}">

  <div class="ec-container">
    <div class="ec-early-card">

      {%- comment -%} ── Spotlight grid (decorative) ── {%- endcomment -%}
      <div class="ec-early-grid" aria-hidden="true"></div>
      <div class="ec-early-glow ec-early-glow-1" aria-hidden="true"></div>
      <div class="ec-early-glow ec-early-glow-2" aria-hidden="true"></div>

      {%- comment -%} ── Status pill ── {%- endcomment -%}
      <div class="ec-early-pill">
        <span class="ec-early-pulse" aria-hidden="true"></span>
        {{ section.settings.pill_text }}
      </div>

      {%- comment -%} ── Big badge headline ── {%- endcomment -%}
      <h2 class="ec-early-badge">{{ section.settings.headline }}</h2>

      {%- if section.settings.subhead != blank -%}
        <p class="ec-early-subhead">{{ section.settings.subhead }}</p>
      {%- endif -%}

      {%- comment -%} ── Optional countdown timer ── {%- endcomment -%}
      {%- if section.settings.show_countdown and launch_date != blank -%}
        <div class="ec-early-countdown" id="ec-early-countdown-{{ sec_id }}" aria-live="polite">
          <div class="ec-early-cd-cell"><span class="num" data-cd-d>--</span><span class="lbl">Days</span></div>
          <div class="ec-early-cd-sep" aria-hidden="true">:</div>
          <div class="ec-early-cd-cell"><span class="num" data-cd-h>--</span><span class="lbl">Hours</span></div>
          <div class="ec-early-cd-sep" aria-hidden="true">:</div>
          <div class="ec-early-cd-cell"><span class="num" data-cd-m>--</span><span class="lbl">Minutes</span></div>
          <div class="ec-early-cd-sep" aria-hidden="true">:</div>
          <div class="ec-early-cd-cell"><span class="num" data-cd-s>--</span><span class="lbl">Seconds</span></div>
        </div>
      {%- endif -%}

      {%- comment -%} ── Form ── {%- endcomment -%}
      {% form 'customer', class: 'ec-early-form' %}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.signup_tag | default: 'early-access,launch-list,homepage' }}">
        {%- if section.settings.accepts_marketing -%}
          <input type="hidden" name="contact[accepts_marketing]" value="true">
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="ec-early-success" role="status">
            <div class="ec-early-success-icon" aria-hidden="true">✓</div>
            <strong>{{ section.settings.success_title }}</strong>
            <p>{{ section.settings.success_message }}</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="ec-early-error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <label for="ec-early-email-{{ sec_id }}" class="ec-visually-hidden">Email address</label>
          <div class="ec-early-row">
            <input
              type="email"
              id="ec-early-email-{{ sec_id }}"
              name="contact[email]"
              placeholder="{{ section.settings.email_placeholder }}"
              required
              autocomplete="email"
              inputmode="email">
            <button type="submit" class="ec-early-submit">
              {{ section.settings.button_label }}
            </button>
          </div>

          {%- if section.settings.fineprint != blank -%}
            <p class="ec-early-fineprint">{{ section.settings.fineprint }}</p>
          {%- endif -%}
        {%- endif -%}
      {% endform %}

      {%- comment -%} ── Trust row ── {%- endcomment -%}
      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank -%}
        <div class="ec-early-trust">
          {%- if section.settings.trust_1 != blank -%}
            <div class="ec-early-trust-item">
              <span class="ec-early-trust-check" aria-hidden="true">✓</span>{{ section.settings.trust_1 }}
            </div>
          {%- endif -%}
          {%- if section.settings.trust_2 != blank -%}
            <div class="ec-early-trust-item">
              <span class="ec-early-trust-check" aria-hidden="true">✓</span>{{ section.settings.trust_2 }}
            </div>
          {%- endif -%}
          {%- if section.settings.trust_3 != blank -%}
            <div class="ec-early-trust-item">
              <span class="ec-early-trust-check" aria-hidden="true">✓</span>{{ section.settings.trust_3 }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

<style>
  /* ── Section wrapper ─────────────────────────────────────────────── */
  .ec-early-section {
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }
  .ec-early-bg-navy {
    background: linear-gradient(160deg, #050b1f 0%, #0a1540 60%, #1565c0 220%);
  }
  .ec-early-bg-light {
    background: linear-gradient(160deg, var(--ec-off-white) 0%, var(--ec-light) 100%);
  }
  .ec-early-bg-electric {
    background: linear-gradient(160deg, #0a1540 0%, #1565c0 100%);
  }
  .ec-early-bg-transparent { background: transparent; }

  /* ── Card ── */
  .ec-early-card {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 48px;
    border-radius: var(--ec-radius-xl, 28px);
    text-align: center;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(79,195,247,0.18);
    overflow: hidden;
    isolation: isolate;
    backdrop-filter: blur(2px);
  }
  .ec-early-bg-light .ec-early-card {
    background: white;
    border-color: var(--ec-border, #e5e7eb);
    box-shadow: 0 24px 80px rgba(10,21,64,0.10);
  }

  /* Decorative grid pattern */
  .ec-early-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(79,195,247,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(79,195,247,0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 30%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }
  .ec-early-bg-light .ec-early-grid {
    background-image:
      linear-gradient(rgba(21,101,192,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(21,101,192,0.05) 1px, transparent 1px);
  }

  /* Spotlight glows */
  .ec-early-glow {
    position: absolute;
    width: 320px; height: 320px;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }
  .ec-early-glow-1 {
    top: -100px; left: -80px;
    background: radial-gradient(circle, rgba(79,195,247,0.4) 0%, transparent 70%);
  }
  .ec-early-glow-2 {
    bottom: -120px; right: -100px;
    background: radial-gradient(circle, rgba(21,101,192,0.45) 0%, transparent 70%);
  }
  .ec-early-bg-light .ec-early-glow-1 {
    background: radial-gradient(circle, rgba(79,195,247,0.18) 0%, transparent 70%);
  }
  .ec-early-bg-light .ec-early-glow-2 {
    background: radial-gradient(circle, rgba(21,101,192,0.18) 0%, transparent 70%);
  }

  /* Lift content above decorations */
  .ec-early-card > *:not(.ec-early-grid):not(.ec-early-glow) {
    position: relative;
    z-index: 1;
  }

  /* ── Status pill ── */
  .ec-early-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(79,195,247,0.12);
    color: var(--ec-accent, #4fc3f7);
    border: 1px solid rgba(79,195,247,0.35);
    padding: 7px 14px;
    border-radius: 999px;
    font-family: var(--ec-font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 22px;
  }
  .ec-early-bg-light .ec-early-pill {
    background: rgba(21,101,192,0.08);
    color: var(--ec-electric);
    border-color: rgba(21,101,192,0.28);
  }
  .ec-early-pulse {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--ec-accent, #4fc3f7);
    box-shadow: 0 0 0 0 rgba(79,195,247,0.7);
    animation: ec-early-pulse 1.8s infinite;
  }
  .ec-early-bg-light .ec-early-pulse { background: var(--ec-electric); }
  @keyframes ec-early-pulse {
    0%   { box-shadow: 0 0 0 0   rgba(79,195,247,0.65); }
    70%  { box-shadow: 0 0 0 10px rgba(79,195,247,0);   }
    100% { box-shadow: 0 0 0 0   rgba(79,195,247,0);    }
  }

  /* ── Big badge headline ── */
  .ec-early-badge {
    font-family: var(--ec-font-display);
    font-size: clamp(48px, 8.5vw, 110px);
    line-height: 0.92;
    letter-spacing: 1px;
    color: white;
    margin: 0 0 16px;
    text-transform: uppercase;
    background: linear-gradient(180deg, #ffffff 0%, #b3d8ff 100%);
    -webkit-background-clip: text;
            background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 2px 30px rgba(79,195,247,0.25);
  }
  .ec-early-bg-light .ec-early-badge {
    background: linear-gradient(180deg, var(--ec-navy) 0%, var(--ec-electric) 100%);
    -webkit-background-clip: text;
            background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: none;
  }

  /* ── Subhead ── */
  .ec-early-subhead {
    color: rgba(255,255,255,0.75);
    font-size: 17px;
    line-height: 1.55;
    margin: 0 auto 32px;
    max-width: 520px;
  }
  .ec-early-bg-light .ec-early-subhead {
    color: var(--ec-text2);
  }

  /* ── Countdown ── */
  .ec-early-countdown {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin: 0 auto 36px;
    padding: 14px 22px;
    border-radius: 14px;
    background: rgba(0,0,0,0.25);
    border: 1px solid rgba(79,195,247,0.20);
  }
  .ec-early-bg-light .ec-early-countdown {
    background: var(--ec-off-white);
    border-color: var(--ec-border, #e5e7eb);
  }
  .ec-early-cd-cell {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    min-width: 56px;
    padding: 0 6px;
  }
  .ec-early-cd-cell .num {
    font-family: var(--ec-font-display);
    font-size: 36px;
    line-height: 1;
    color: white;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
  }
  .ec-early-bg-light .ec-early-cd-cell .num { color: var(--ec-navy); }
  .ec-early-cd-cell .lbl {
    font-family: var(--ec-font-mono);
    font-size: 9px;
    letter-spacing: 1.6px;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    margin-top: 6px;
  }
  .ec-early-bg-light .ec-early-cd-cell .lbl { color: var(--ec-text3); }
  .ec-early-cd-sep {
    font-family: var(--ec-font-display);
    font-size: 28px;
    color: rgba(255,255,255,0.25);
    line-height: 1;
    transform: translateY(-7px);
  }
  .ec-early-bg-light .ec-early-cd-sep { color: var(--ec-text4); }

  /* ── Form ── */
  .ec-early-form { margin: 0 auto; max-width: 480px; }
  .ec-early-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }
  .ec-early-row input[type="email"] {
    flex: 1;
    padding: 16px 18px;
    font-size: 16px;
    border-radius: 12px;
    border: 1.5px solid rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.06);
    color: white;
    outline: none;
    font-family: inherit;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    box-sizing: border-box;
    -webkit-appearance: none;
       -moz-appearance: none;
            appearance: none;
  }
  .ec-early-row input[type="email"]::placeholder { color: rgba(255,255,255,0.4); }
  .ec-early-row input[type="email"]:focus {
    border-color: var(--ec-accent, #4fc3f7);
    background: rgba(255,255,255,0.12);
    box-shadow: 0 0 0 3px rgba(79,195,247,0.18);
  }
  .ec-early-bg-light .ec-early-row input[type="email"] {
    border-color: var(--ec-border, #e5e7eb);
    background: white;
    color: var(--ec-navy);
  }
  .ec-early-bg-light .ec-early-row input[type="email"]::placeholder { color: var(--ec-text3); }
  .ec-early-bg-light .ec-early-row input[type="email"]:focus {
    border-color: var(--ec-electric);
    box-shadow: 0 0 0 3px rgba(21,101,192,0.12);
  }

  .ec-early-submit {
    padding: 16px 24px;
    background: var(--ec-electric, #1565c0);
    background-image: linear-gradient(180deg, var(--ec-electric2, #1e88e5) 0%, var(--ec-electric, #1565c0) 100%);
    color: white;
    border: 0;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.05s ease, box-shadow 0.18s ease, filter 0.18s ease;
    font-family: var(--ec-font-mono);
    box-shadow: 0 8px 24px rgba(21,101,192,0.4);
    white-space: nowrap;
  }
  .ec-early-submit:hover { filter: brightness(1.1); box-shadow: 0 12px 32px rgba(21,101,192,0.5); }
  .ec-early-submit:active { transform: translateY(1px); }

  .ec-early-fineprint {
    font-size: 12px;
    color: rgba(255,255,255,0.5);
    margin: 6px 0 0;
    line-height: 1.5;
  }
  .ec-early-bg-light .ec-early-fineprint { color: var(--ec-text3); }

  /* ── Success/error ── */
  .ec-early-success {
    background: rgba(16,185,129,0.12);
    border: 1px solid rgba(16,185,129,0.4);
    color: #a7f3d0;
    padding: 24px;
    border-radius: 14px;
    text-align: center;
    margin: 0 auto;
    max-width: 480px;
  }
  .ec-early-bg-light .ec-early-success {
    background: #ecfdf5;
    border-color: #a7f3d0;
    color: #065f46;
  }
  .ec-early-success-icon {
    width: 44px; height: 44px; border-radius: 50%;
    background: #10b981; color: white;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 22px; font-weight: 800;
    margin-bottom: 12px;
  }
  .ec-early-success strong {
    display: block;
    font-family: var(--ec-font-display);
    font-size: 24px;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
    color: white;
  }
  .ec-early-bg-light .ec-early-success strong { color: var(--ec-navy); }
  .ec-early-success p { margin: 0; font-size: 14px; line-height: 1.5; }

  .ec-early-error {
    background: rgba(220,38,38,0.12);
    border: 1px solid rgba(220,38,38,0.4);
    color: #fca5a5;
    padding: 12px 14px;
    border-radius: 10px;
    margin-bottom: 14px;
    font-size: 14px;
    text-align: left;
  }
  .ec-early-bg-light .ec-early-error {
    background: #fef2f2;
    border-color: #fecaca;
    color: #991b1b;
  }

  /* ── Trust row ── */
  .ec-early-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px 28px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .ec-early-bg-light .ec-early-trust { border-top-color: var(--ec-border, #e5e7eb); }
  .ec-early-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: rgba(255,255,255,0.7);
  }
  .ec-early-bg-light .ec-early-trust-item { color: var(--ec-text2); }
  .ec-early-trust-check {
    width: 18px; height: 18px;
    border-radius: 50%;
    background: rgba(79,195,247,0.15);
    color: var(--ec-accent, #4fc3f7);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .ec-early-bg-light .ec-early-trust-check {
    background: rgba(21,101,192,0.1);
    color: var(--ec-electric);
  }

  /* ── Visually hidden helper ── */
  .ec-visually-hidden {
    position: absolute !important;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  /* ── Desktop: side-by-side input + button ── */
  @media (min-width: 540px) {
    .ec-early-row { flex-direction: row; }
  }

  /* ── Mobile tweaks ── */
  @media (max-width: 640px) {
    .ec-early-section { padding: 56px 0; }
    .ec-early-card {
      padding: 40px 24px;
      border-radius: 20px;
    }
    .ec-early-pill {
      font-size: 10px;
      padding: 6px 12px;
      letter-spacing: 1.6px;
      margin-bottom: 18px;
    }
    .ec-early-subhead {
      font-size: 15px;
      margin-bottom: 24px;
    }
    .ec-early-countdown {
      gap: 2px;
      padding: 12px 10px;
      margin-bottom: 28px;
    }
    .ec-early-cd-cell {
      min-width: 44px;
      padding: 0 2px;
    }
    .ec-early-cd-cell .num { font-size: 26px; }
    .ec-early-cd-cell .lbl { font-size: 8px; letter-spacing: 1.2px; }
    .ec-early-cd-sep { font-size: 22px; transform: translateY(-5px); }
    .ec-early-row input[type="email"] { padding: 14px 16px; font-size: 16px; /* keep 16px to prevent iOS zoom */ }
    .ec-early-submit { padding: 15px 20px; }
    .ec-early-trust { gap: 12px 20px; margin-top: 24px; padding-top: 18px; }
    .ec-early-trust-item { font-size: 12px; }
  }

  @media (max-width: 380px) {
    .ec-early-card { padding: 32px 18px; }
    .ec-early-cd-cell { min-width: 38px; }
    .ec-early-cd-cell .num { font-size: 22px; }
    .ec-early-cd-sep { font-size: 18px; }
  }
</style>

{%- if section.settings.show_countdown and launch_date != blank -%}
<script>
  (function () {
    var sec = document.getElementById('ec-early-{{ sec_id }}');
    if (!sec) return;
    var iso = sec.getAttribute('data-launch-date');
    if (!iso) return;
    var target = new Date(iso).getTime();
    if (isNaN(target)) return;

    var dEl = sec.querySelector('[data-cd-d]');
    var hEl = sec.querySelector('[data-cd-h]');
    var mEl = sec.querySelector('[data-cd-m]');
    var sEl = sec.querySelector('[data-cd-s]');

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function tick() {
      var diff = target - Date.now();
      if (diff <= 0) {
        if (dEl) dEl.textContent = '00';
        if (hEl) hEl.textContent = '00';
        if (mEl) mEl.textContent = '00';
        if (sEl) sEl.textContent = '00';
        return false;
      }
      var d = Math.floor(diff / 86400000);
      var h = Math.floor(diff % 86400000 / 3600000);
      var m = Math.floor(diff % 3600000 / 60000);
      var s = Math.floor(diff % 60000 / 1000);
      if (dEl) dEl.textContent = pad(d);
      if (hEl) hEl.textContent = pad(h);
      if (mEl) mEl.textContent = pad(m);
      if (sEl) sEl.textContent = pad(s);
      return true;
    }

    tick();
    var interval = setInterval(function () {
      if (!tick()) clearInterval(interval);
    }, 1000);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Early access signup",
  "tag": "section",
  "class": "ec-early-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "bg_style",
      "label": "Background style",
      "options": [
        { "value": "navy",        "label": "Dark navy gradient (recommended)" },
        { "value": "electric",    "label": "Electric blue gradient" },
        { "value": "light",       "label": "Light / off-white" },
        { "value": "transparent", "label": "Transparent (use page bg)" }
      ],
      "default": "navy"
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "pill_text",
      "label": "Status pill text",
      "default": "Pre-Launch · Limited Spots"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Big headline",
      "default": "Early Access"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "Drop your email and we'll let you know the moment we launch — first in line, first to know."
    },
    {
      "type": "header",
      "content": "Countdown timer"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown to launch",
      "default": false
    },
    {
      "type": "text",
      "id": "launch_date",
      "label": "Launch date/time (ISO format)",
      "info": "Use ISO 8601 format, e.g. 2026-08-15T09:00:00-04:00. Empty = hide countdown.",
      "default": "2026-08-15T09:00:00-04:00"
    },
    {
      "type": "header",
      "content": "Form"
    },
