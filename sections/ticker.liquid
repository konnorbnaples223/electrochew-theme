<div class="ec-ticker" style="background:{{ section.settings.bg_color }};">
  <div class="ec-ticker-track">
    {%- for block in section.blocks -%}
      <span class="ec-ticker-item" style="color:{{ section.settings.text_color }};">
        {{ block.settings.text }}
        <span class="ec-ticker-dot" aria-hidden="true"></span>
      </span>
    {%- endfor -%}
    {%- for block in section.blocks -%}
      <span class="ec-ticker-item" style="color:{{ section.settings.text_color }};">
        {{ block.settings.text }}
        <span class="ec-ticker-dot" aria-hidden="true"></span>
      </span>
    {%- endfor -%}
  </div>
</div>

<style>
.ec-ticker-dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--ec-accent);vertical-align:middle;margin-left:24px;}
</style>

{% schema %}
{
  "name": "Ticker bar",
  "tag": "section",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#0a1540"},
    {"type":"color","id":"text_color","label":"Text color","default":"#ffffff"}
  ],
  "blocks":[{"type":"item","name":"Ticker text","settings":[{"type":"text","id":"text","label":"Text","default":"No Sugar"}]}],
  "max_blocks":16,
  "presets":[{
    "name":"Ticker bar",
    "blocks":[
      {"type":"item","settings":{"text":"Potassium"}},
      {"type":"item","settings":{"text":"Magnesium"}},
      {"type":"item","settings":{"text":"Calcium"}},
      {"type":"item","settings":{"text":"Zero Sugar"}},
      {"type":"item","settings":{"text":"No Aspartame"}},
      {"type":"item","settings":{"text":"No Artificial Colors"}},
      {"type":"item","settings":{"text":"Oral Mucosa Absorption"}},
      {"type":"item","settings":{"text":"Works in Minutes"}},
      {"type":"item","settings":{"text":"No Water Needed"}}
    ]
  }]
}
{% endschema %}
