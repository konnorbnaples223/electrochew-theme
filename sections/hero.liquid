{%- comment -%}Hero v2 — button CTAs, floating elements, product visual{%- endcomment -%}

<section class="ec-hv2">
  <div class="ec-hv2-bg">
    {%- if section.settings.bg_image != blank -%}
      <img src="{{ section.settings.bg_image | img_url: '2400x' }}" srcset="{{ section.settings.bg_image | img_url: '1200x' }} 1200w, {{ section.settings.bg_image | img_url: '2400x' }} 2400w" sizes="100vw" alt="{{ section.settings.bg_alt | default: 'ElectroChew' }}" class="ec-hv2-img" fetchpriority="high">
    {%- else -%}
      <img src="{{ 'hero-bg.jpg' | asset_url }}" alt="ElectroChew" class="ec-hv2-img" fetchpriority="high">
    {%- endif -%}
    <div class="ec-hv2-overlay"></div>
    <div class="ec-hv2-grid-bg"></div>
  </div>

  <div class="ec-hv2-float ec-hv2-k" aria-hidden="true"><span class="fv-n">19</span><span class="fv-s">K</span><span class="fv-l">Potassium</span></div>
  <div class="ec-hv2-float ec-hv2-mg" aria-hidden="true"><span class="fv-n">12</span><span class="fv-s">Mg</span><span class="fv-l">Magnesium</span></div>
  <div class="ec-hv2-float ec-hv2-ca" aria-hidden="true"><span class="fv-n">20</span><span class="fv-s">Ca</span><span class="fv-l">Calcium</span></div>

  <div class="ec-hv2-inner ec-container">
    <div class="ec-hv2-content">

      <div class="ec-hv2-badge">
        <span class="ec-hv2-pulse"></span>
        {{ section.settings.badge_text | default: 'Electrolyte Chewing Gum - Now Available' }}
      </div>

      {%- if section.settings.eyebrow != blank -%}
        <div class="ec-hv2-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}

      <h1 class="ec-hv2-headline">{{ section.settings.headline | default: 'For all the moments inbetween.' }}</h1>

      {%- if section.settings.subhead != blank -%}
        <p class="ec-hv2-sub">{{ section.settings.subhead }}</p>
      {%- endif -%}

      <div class="ec-hv2-ctas">
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_url | default: '#' }}" class="ec-hv2-btn-primary">
            {{ section.settings.cta_primary_label | default: 'Try for Free' }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.cta_ghost_label != blank -%}
          <a href="{{ section.settings.cta_ghost_url | default: '#' }}" class="ec-hv2-btn-ghost">
            {{ section.settings.cta_ghost_label | default: 'See the Science' }}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </a>
        {%- endif -%}
      </div>

      <div class="ec-hv2-stats">
        {%- if section.settings.stat_1_num != blank -%}
          <div class="ec-hv2-stat"><div class="ec-hv2-stat-n">{{ section.settings.stat_1_num }}</div><div class="ec-hv2-stat-l">{{ section.settings.stat_1_label }}</div></div>
        {%- endif -%}
        {%- if section.settings.stat_2_num != blank -%}
          <div class="ec-hv2-stat"><div class="ec-hv2-stat-n">{{ section.settings.stat_2_num }}</div><div class="ec-hv2-stat-l">{{ section.settings.stat_2_label }}</div></div>
        {%- endif -%}
        {%- if section.settings.stat_3_num != blank -%}
          <div class="ec-hv2-stat"><div class="ec-hv2-stat-n">{{ section.settings.stat_3_num }}</div><div class="ec-hv2-stat-l">{{ section.settings.stat_3_label }}</div></div>
        {%- endif -%}
        {%- if section.settings.stat_4_num != blank -%}
          <div class="ec-hv2-stat"><div class="ec-hv2-stat-n">{{ section.settings.stat_4_num }}</div><div class="ec-hv2-stat-l">{{ section.settings.stat_4_label }}</div></div>
        {%- endif -%}
      </div>

    </div>

    <div class="ec-hv2-visual">
      <div class="ec-hv2-glow"></div>
      <div class="ec-hv2-ring"></div>
      <div class="ec-hv2-ring2"></div>
      {%- if section.settings.product_image != blank -%}
        <img class="ec-hv2-product" src="{{ section.settings.product_image | img_url: '700x' }}" alt="{{ section.settings.product_image_alt | default: 'ElectroChew' }}">
      {%- else -%}
        <img class="ec-hv2-product" src="{{ 'product-front.jpg' | asset_url }}" alt="ElectroChew Electrolyte Gum">
      {%- endif -%}
    </div>
  </div>
</section>

<style>
.ec-hv2{position:relative;min-height:92vh;display:flex;flex-direction:column;justify-content:center;overflow:hidden;background:#0a1235;color:white;}
.ec-hv2-bg{position:absolute;inset:0;z-index:0;}
.ec-hv2-img{width:100%;height:100%;object-fit:cover;object-position:center 30%;opacity:.32;}
.ec-hv2-overlay{position:absolute;inset:0;background:linear-gradient(105deg,rgba(10,18,53,.97) 0%,rgba(10,18,53,.8) 45%,rgba(10,18,53,.18) 100%);}
.ec-hv2-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(79,195,247,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(79,195,247,.04) 1px,transparent 1px);background-size:72px 72px;mask-image:radial-gradient(ellipse 80% 70% at 30% 50%,black 20%,transparent 70%);-webkit-mask-image:radial-gradient(ellipse 80% 70% at 30% 50%,black 20%,transparent 70%);}
.ec-hv2-float{position:absolute;display:flex;flex-direction:column;align-items:center;justify-content:center;width:64px;height:64px;border:1.5px solid rgba(79,195,247,.25);border-radius:8px;background:rgba(79,195,247,.07);backdrop-filter:blur(12px);z-index:3;animation:ecHv2F 12s ease-in-out infinite;}
.fv-n{font-family:var(--ec-font-mono);font-size:9px;color:rgba(79,195,247,.6);line-height:1;}
.fv-s{font-family:var(--ec-font-display);font-size:22px;color:var(--ec-accent);line-height:1;}
.fv-l{font-family:var(--ec-font-mono);font-size:7px;color:rgba(255,255,255,.4);letter-spacing:.5px;text-transform:uppercase;margin-top:2px;}
.ec-hv2-k{top:18%;right:38%;animation-delay:0s;}
.ec-hv2-mg{bottom:28%;right:32%;animation-delay:-3s;}
.ec-hv2-ca{top:30%;right:22%;animation-delay:-6s;}
@keyframes ecHv2F{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.ec-hv2-inner{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:64px;min-height:92vh;padding-top:40px;padding-bottom:40px;}
.ec-hv2-content{padding:80px 0;}
.ec-hv2-badge{display:inline-flex;align-items:center;gap:9px;padding:7px 16px;background:rgba(79,195,247,.1);border:1px solid rgba(79,195,247,.3);border-radius:999px;font-family:var(--ec-font-mono);font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--ec-accent);margin-bottom:28px;}
.ec-hv2-pulse{width:6px;height:6px;border-radius:50%;background:var(--ec-accent);box-shadow:0 0 8px var(--ec-accent);animation:ecHv2P 2s ease-in-out infinite;}
@keyframes ecHv2P{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.75)}}
.ec-hv2-eyebrow{font-family:var(--ec-font-mono);font-size:12px;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.5);margin-bottom:18px;display:flex;align-items:center;gap:12px;}
.ec-hv2-eyebrow::before{content:'';display:inline-block;width:28px;height:1.5px;background:var(--ec-accent);}
.ec-hv2-headline{font-family:var(--ec-font-display);font-size:clamp(64px,8.5vw,118px);line-height:.9;letter-spacing:1px;color:white;margin-bottom:28px;text-transform:uppercase;}
.ec-hv2-headline .em{color:var(--ec-accent);}
.ec-hv2-sub{font-size:18px;line-height:1.65;color:rgba(255,255,255,.72);max-width:480px;margin-bottom:40px;}
.ec-hv2-ctas{display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
.ec-hv2-btn-primary{display:inline-flex;align-items:center;gap:9px;font-family:var(--ec-font-display);font-size:22px;letter-spacing:2px;padding:16px 40px;background:white;color:var(--ec-navy);border-radius:4px;border:2px solid white;transition:all .2s;white-space:nowrap;text-decoration:none;}
.ec-hv2-btn-primary:hover{background:var(--ec-accent);border-color:var(--ec-accent);color:white;transform:translateY(-2px);box-shadow:0 12px 36px rgba(79,195,247,.35);}
.ec-hv2-btn-ghost{display:inline-flex;align-items:center;gap:9px;font-family:var(--ec-font-mono);font-size:11px;letter-spacing:2.5px;text-transform:uppercase;padding:16px 28px;color:rgba(255,255,255,.7);border:1.5px solid rgba(255,255,255,.2);border-radius:4px;transition:all .2s;text-decoration:none;}
.ec-hv2-btn-ghost:hover{border-color:rgba(255,255,255,.6);color:white;}
.ec-hv2-stats{display:flex;align-items:center;margin-top:56px;padding-top:40px;border-top:1px solid rgba(255,255,255,.08);}
.ec-hv2-stat{flex:1;text-align:center;padding:0 20px;border-right:1px solid rgba(255,255,255,.08);}
.ec-hv2-stat:first-child{padding-left:0;text-align:left;}
.ec-hv2-stat:last-child{border-right:none;}
.ec-hv2-stat-n{font-family:var(--ec-font-display);font-size:36px;color:var(--ec-accent);line-height:1;margin-bottom:6px;}
.ec-hv2-stat-l{font-family:var(--ec-font-mono);font-size:9.5px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.4);line-height:1.3;}
.ec-hv2-visual{position:relative;display:flex;justify-content:center;align-items:center;min-height:500px;}
.ec-hv2-glow{position:absolute;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,rgba(21,101,192,.3) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);filter:blur(40px);z-index:1;}
.ec-hv2-ring{position:absolute;width:360px;height:360px;border:1px solid rgba(79,195,247,.15);border-radius:50%;top:50%;left:50%;transform:translate(-50%,-50%);animation:ecHv2R 4s ease-in-out infinite;z-index:1;}
.ec-hv2-ring2{position:absolute;width:480px;height:480px;border:1px solid rgba(79,195,247,.08);border-radius:50%;top:50%;left:50%;transform:translate(-50%,-50%);animation:ecHv2R 4s ease-in-out infinite;animation-delay:-2s;z-index:1;}
@keyframes ecHv2R{0%,100%{opacity:1;transform:translate(-50%,-50%) scale(1)}50%{opacity:.5;transform:translate(-50%,-50%) scale(1.04)}}
.ec-hv2-product{position:relative;z-index:2;max-width:340px;width:100%;filter:drop-shadow(0 32px 64px rgba(0,0,0,.5));animation:ecHv2Pf 6s ease-in-out infinite;}
@keyframes ecHv2Pf{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-16px) rotate(1deg)}}
@media(max-width:1024px){
  .ec-hv2-inner{grid-template-columns:1fr;text-align:center;gap:48px;min-height:auto;padding:120px 28px 80px;}
  .ec-hv2-float{display:none;}
  .ec-hv2-content{padding:0;}
  .ec-hv2-eyebrow,.ec-hv2-ctas{justify-content:center;}
  .ec-hv2-sub{margin-left:auto;margin-right:auto;}
  .ec-hv2-stats{justify-content:center;flex-wrap:wrap;gap:20px;}
  .ec-hv2-stat{border-right:none;min-width:120px;}
  .ec-hv2-stat:first-child{text-align:center;}
  .ec-hv2-visual{min-height:280px;}
}
@media(max-width:768px){
  .ec-hv2-inner{padding:100px 20px 60px;}
  .ec-hv2-headline{font-size:clamp(54px,13vw,80px);}
  .ec-hv2-product{max-width:220px;}
}
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {"type":"header","content":"Background"},
    {"type":"image_picker","id":"bg_image","label":"Background image"},
    {"type":"text","id":"bg_alt","label":"Image alt text","default":"ElectroChew Electrolyte Chewing Gum"},
    {"type":"header","content":"Product image"},
    {"type":"image_picker","id":"product_image","label":"Product image (right side)"},
    {"type":"text","id":"product_image_alt","label":"Alt text","default":"ElectroChew Electrolyte Gum"},
    {"type":"header","content":"Content"},
    {"type":"text","id":"badge_text","label":"Badge text","default":"Electrolyte Chewing Gum - Now Available"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Smarter Way to Hydrate"},
    {"type":"text","id":"headline","label":"Headline","default":"For all the moments inbetween."},
    {"type":"textarea","id":"subhead","label":"Subhead","default":"Electrolytes absorbed directly through your cheek - not your gut. No bottle. No mixing. No waiting. Just chew, and perform."},
    {"type":"header","content":"Buttons"},
    {"type":"text","id":"cta_primary_label","label":"Primary button text","default":"Try for Free"},
    {"type":"text","id":"cta_primary_url","label":"Primary button URL","default":"/collections/all"},
    {"type":"text","id":"cta_ghost_label","label":"Ghost button text","default":"See the Science"},
    {"type":"text","id":"cta_ghost_url","label":"Ghost button URL","default":"/pages/science"},
    {"type":"header","content":"Stats row"},
    {"type":"text","id":"stat_1_num","label":"Stat 1 number","default":"5-10"},
    {"type":"text","id":"stat_1_label","label":"Stat 1 label","default":"Minutes to absorb"},
    {"type":"text","id":"stat_2_num","label":"Stat 2 number","default":"3"},
    {"type":"text","id":"stat_2_label","label":"Stat 2 label","default":"Key electrolytes per piece"},
    {"type":"text","id":"stat_3_num","label":"Stat 3 number","default":"0g"},
    {"type":"text","id":"stat_3_label","label":"Stat 3 label","default":"Sugar in every piece"},
    {"type":"text","id":"stat_4_num","label":"Stat 4 number","default":"100%"},
    {"type":"text","id":"stat_4_label","label":"Stat 4 label","default":"Clean label formula"}
  ],
  "presets":[{"name":"Hero"}]
}
{% endschema %}
