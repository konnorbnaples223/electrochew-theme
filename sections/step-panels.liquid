{%- comment -%}Step Panels — white triptych, big word + hover reveal{%- endcomment -%}

<section class="ec-sp" id="section-{{ section.id }}">
  <div class="ec-sp-grid">
    {%- for block in section.blocks -%}
      <div class="ec-sp-panel" {{ block.shopify_attributes }}>
        <div class="ec-sp-inner">
          <div class="ec-sp-word">{{ block.settings.word }}</div>
          <div class="ec-sp-reveal">
            <div class="ec-sp-line" aria-hidden="true"></div>
            <p class="ec-sp-desc">{{ block.settings.description }}</p>
          </div>
        </div>
        <div class="ec-sp-bottom-bar" aria-hidden="true"></div>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
/* ── Section ── */
.ec-sp{background:#ffffff;overflow:hidden;}
.ec-sp-grid{display:grid;grid-template-columns:repeat(3,1fr);min-height:480px;}

/* ── Panel ── */
.ec-sp-panel{
  position:relative;
  display:flex;
  align-items:flex-end;
  padding:0 48px 56px;
  border-right:1px solid rgba(10,21,64,.07);
  overflow:hidden;
  cursor:default;
  background:white;
  transition:background .35s;
}
.ec-sp-panel:last-child{border-right:none;}
.ec-sp-panel:hover{background:#f8f9ff;}

/* ── Content ── */
.ec-sp-inner{width:100%;}

/* The word */
.ec-sp-word{
  font-family:var(--ec-font-display);
  font-size:clamp(72px,8vw,108px);
  line-height:.88;
  letter-spacing:2px;
  text-transform:uppercase;
  color:var(--ec-navy);
  display:block;
  transition:transform .5s cubic-bezier(0.22,1,0.36,1), color .3s;
  will-change:transform;
}
.ec-sp-panel:hover .ec-sp-word{
  transform:translateY(-16px);
  color:#1565c0;
}

/* Reveal block — hidden until hover */
.ec-sp-reveal{
  overflow:hidden;
  max-height:0;
  opacity:0;
  transition:max-height .55s cubic-bezier(0.22,1,0.36,1), opacity .4s ease .08s;
}
.ec-sp-panel:hover .ec-sp-reveal{
  max-height:180px;
  opacity:1;
}

/* Divider that draws in on hover */
.ec-sp-line{
  width:0;
  height:2px;
  background:#1565c0;
  margin:16px 0 14px;
  transition:width .5s cubic-bezier(0.22,1,0.36,1) .08s;
}
.ec-sp-panel:hover .ec-sp-line{width:44px;}

/* Description */
.ec-sp-desc{
  font-size:14.5px;
  line-height:1.7;
  color:rgba(10,21,64,.55);
  margin:0;
  max-width:300px;
}

/* Bottom accent bar */
.ec-sp-bottom-bar{
  position:absolute;
  bottom:0;left:0;right:0;
  height:3px;
  background:linear-gradient(90deg,#1565c0,#4fc3f7);
  transform:scaleX(0);
  transform-origin:left;
  transition:transform .55s cubic-bezier(0.22,1,0.36,1);
}
.ec-sp-panel:hover .ec-sp-bottom-bar{transform:scaleX(1);}

/* ── Responsive ── */
@media(max-width:900px){
  .ec-sp-grid{grid-template-columns:1fr;}
  .ec-sp-panel{
    border-right:none;
    border-bottom:1px solid rgba(10,21,64,.07);
    padding:48px 32px;
    align-items:flex-start;
    min-height:auto;
  }
  .ec-sp-panel:last-child{border-bottom:none;}
  /* Always show content on mobile */
  .ec-sp-reveal{max-height:180px;opacity:1;}
  .ec-sp-line{width:44px;}
  .ec-sp-word{transform:translateY(-8px);}
}
</style>

{% schema %}
{
  "name": "Step Panels",
  "tag": "section",
  "blocks":[{
    "type":"panel","name":"Panel",
    "settings":[
      {"type":"text","id":"word","label":"Word","default":"Open"},
      {"type":"textarea","id":"description","label":"Description on hover","default":"Pull out a piece. No shaker bottle, no measuring, no mixing. Ready wherever you are."}
    ]
  }],
  "max_blocks":3,
  "presets":[{
    "name":"Step Panels",
    "blocks":[
      {"type":"panel","settings":{"word":"Open","description":"Pull out a piece. No shaker bottle, no measuring, no mixing. Ready wherever you are."}},
      {"type":"panel","settings":{"word":"Chew","description":"Electrolytes absorb through your oral mucosa directly into your bloodstream - bypassing digestion entirely."}},
      {"type":"panel","settings":{"word":"Electrolytes","description":"Potassium, Magnesium, and Calcium reach your bloodstream in 5-10 minutes. No crash, no stomach upset."}}
    ]
  }]
}
{% endschema %}
