<footer class="ec-footer" style="background:{{ section.settings.bg_color }};">
  <div class="ec-container">
    <div class="ec-footer-grid">
      <div class="ec-footer-logo">
        {% if section.settings.logo %}
          <img src="{{ section.settings.logo | img_url: '300x' }}" alt="{{ shop.name }}" style="height:40px;object-fit:contain;margin-bottom:18px;">
        {% else %}
          <img src="{{ 'logo-white.png' | asset_url }}" alt="ElectroChew" style="height:40px;object-fit:contain;margin-bottom:18px;" onerror="this.src='{{ 'logo.jpg' | asset_url }}'">
        {% endif %}
        <p class="ec-footer-tagline">{{ section.settings.tagline }}</p>
        <div class="ec-footer-social">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.youtube_url != blank %}
            <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 001.46 6.42 29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" stroke="none"/></svg>
            </a>
          {% endif %}
        </div>
      </div>

      {% for block in section.blocks %}
        <div class="ec-footer-col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          {% if block.settings.link_1_text != blank %}<a href="{{ block.settings.link_1_url }}">{{ block.settings.link_1_text }}</a>{% endif %}
          {% if block.settings.link_2_text != blank %}<a href="{{ block.settings.link_2_url }}">{{ block.settings.link_2_text }}</a>{% endif %}
          {% if block.settings.link_3_text != blank %}<a href="{{ block.settings.link_3_url }}">{{ block.settings.link_3_text }}</a>{% endif %}
          {% if block.settings.link_4_text != blank %}<a href="{{ block.settings.link_4_url }}">{{ block.settings.link_4_text }}</a>{% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ec-footer-bottom">
      <span>{{ section.settings.copyright }}</span>
      <span>{{ section.settings.location }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (light version)" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Electrolyte gum that works in real time. No water required." },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2026 ElectroChew — Per Os Biosciences LLC · Charleston, SC" },
    { "type": "text", "id": "location", "label": "Location", "default": "Formulated in the USA 🇺🇸" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#05091a" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "text", "id": "link_1_text", "label": "Link 1 text" },
        { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
        { "type": "text", "id": "link_2_text", "label": "Link 2 text" },
        { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
        { "type": "text", "id": "link_3_text", "label": "Link 3 text" },
        { "type": "url", "id": "link_3_url", "label": "Link 3 URL" },
        { "type": "text", "id": "link_4_text", "label": "Link 4 text" },
        { "type": "url", "id": "link_4_url", "label": "Link 4 URL" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "column", "settings": { "heading": "Shop", "link_1_text": "Free Trial", "link_1_url": "/products/electrochew-free-trial-6-pck", "link_2_text": "30 Piece Pack", "link_2_url": "/products/electrochew-30-piece-pack", "link_3_text": "Athlete Pack", "link_3_url": "/products/electrochew-athlete-pack-60-pieces", "link_4_text": "All Products", "link_4_url": "/collections/all" } },
        { "type": "column", "settings": { "heading": "Company", "link_1_text": "About", "link_1_url": "/pages/about", "link_2_text": "Ambassadors", "link_2_url": "/pages/ambassador", "link_3_text": "Contact", "link_3_url": "/pages/contact" } },
        { "type": "column", "settings": { "heading": "Legal", "link_1_text": "Shipping", "link_1_url": "/policies/shipping-policy", "link_2_text": "Returns", "link_2_url": "/policies/refund-policy", "link_3_text": "Privacy", "link_3_url": "/policies/privacy-policy", "link_4_text": "Terms", "link_4_url": "/policies/terms-of-service" } }
      ]
    }
  ]
}
{% endschema %}
