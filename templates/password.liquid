{% layout 'password' %}

<section class="ec-pw">
  <div class="ec-pw-bg">
    <img src="{{ 'hero-bg.jpg' | asset_url }}" alt="" class="ec-pw-bg-img">
    <div class="ec-pw-overlay"></div>
  </div>

  <div class="ec-pw-inner">
    <div class="ec-pw-logo">
      {%- if settings.logo -%}
        <img src="{{ settings.logo | img_url: '300x' }}" alt="{{ shop.name }}">
      {%- else -%}
        <div class="ec-pw-logo-text">{{ shop.name }}</div>
      {%- endif -%}
    </div>

    <h1 class="ec-pw-headline">Coming<br><span class="em">Soon.</span></h1>
    <p class="ec-pw-sub">Something big is launching. Drop your email to be first in line.</p>

    {% form 'customer', class: 'ec-pw-form' %}
      <input type="hidden" name="contact[tags]" value="early-access,password-page">
      <input type="hidden" name="contact[accepts_marketing]" value="true">
      {%- if form.posted_successfully? -%}
        <div class="ec-pw-success">✓ You're on the list. We'll be in touch.</div>
      {%- else -%}
        {%- if form.errors -%}
          <div class="ec-pw-error">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="ec-pw-row">
          <input type="email" name="contact[email]" placeholder="yourname@email.com" required autocomplete="email">
          <button type="submit">Notify Me ⚡</button>
        </div>
        <p class="ec-pw-fine">No spam. Launch updates only.</p>
      {%- endif -%}
    {% endform %}

    <div class="ec-pw-admin">
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <input type="password" name="password" placeholder="Store password" class="ec-pw-admin-input">
        <button type="submit" class="ec-pw-admin-btn">Enter store</button>
      {% endform %}
    </div>
  </div>
</section>

<style>
.ec-pw{position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#050b1f;color:white;overflow:hidden;}
.ec-pw-bg{position:absolute;inset:0;}
.ec-pw-bg-img{width:100%;height:100%;object-fit:cover;opacity:.18;}
.ec-pw-overlay{position:absolute;inset:0;background:linear-gradient(135deg,rgba(5,11,31,.97) 0%,rgba(10,18,50,.85) 100%);}
.ec-pw-inner{position:relative;z-index:1;text-align:center;max-width:560px;padding:40px 24px;width:100%;}
.ec-pw-logo{margin-bottom:40px;}
.ec-pw-logo img{height:48px;margin:0 auto;}
.ec-pw-logo-text{font-family:'Bebas Neue',sans-serif;font-size:36px;letter-spacing:3px;color:white;}
.ec-pw-headline{font-family:'Bebas Neue',sans-serif;font-size:clamp(72px,12vw,120px);line-height:.9;text-transform:uppercase;margin-bottom:20px;}
.ec-pw-headline .em{color:#4fc3f7;}
.ec-pw-sub{font-size:16px;color:rgba(255,255,255,.6);margin-bottom:36px;line-height:1.6;}
.ec-pw-form{margin-bottom:40px;}
.ec-pw-row{display:flex;border-radius:12px;overflow:hidden;border:1.5px solid rgba(79,195,247,.3);background:rgba(255,255,255,.04);}
.ec-pw-row input{flex:1;padding:16px 18px;background:transparent;border:none;color:white;font-size:16px;outline:none;min-width:0;}
.ec-pw-row input::placeholder{color:rgba(255,255,255,.35);}
.ec-pw-row button{padding:16px 24px;background:linear-gradient(135deg,#1e88e5,#1565c0);color:white;border:none;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;cursor:pointer;white-space:nowrap;}
.ec-pw-fine{font-size:12px;color:rgba(255,255,255,.35);margin-top:10px;}
.ec-pw-success{padding:14px 20px;background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.35);border-radius:10px;color:#a7f3d0;font-size:14px;}
.ec-pw-error{padding:10px 14px;background:rgba(220,38,38,.1);border:1px solid rgba(220,38,38,.3);border-radius:8px;color:#fca5a5;font-size:13px;margin-bottom:12px;}
.ec-pw-admin{padding-top:32px;border-top:1px solid rgba(255,255,255,.07);}
.ec-pw-admin form{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;}
.ec-pw-admin-input{padding:10px 14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:8px;color:white;font-size:14px;outline:none;}
.ec-pw-admin-input::placeholder{color:rgba(255,255,255,.3);}
.ec-pw-admin-btn{padding:10px 20px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:8px;color:rgba(255,255,255,.6);font-size:12px;cursor:pointer;}
@media(max-width:480px){.ec-pw-row{flex-direction:column;}.ec-pw-row button{padding:14px;}}
</style>
